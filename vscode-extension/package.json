{
  "name": "my-assistant",
  "displayName": "My Assistant",
  "description": "My Assistant — personal AI chat panel inside VS Code",
  "version": "0.1.0",
  "publisher": "pontapalli",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "my-assistant",
          "title": "My Assistant",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "my-assistant": [
        {
          "type": "webview",
          "id": "my-assistant.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "my-assistant.open",
        "title": "My Assistant: Open Chat Panel"
      },
      {
        "command": "my-assistant.reload",
        "title": "My Assistant: Reload"
      }
    ]
  }
}
